{
  servers {
    protocols h1 h2
  }
}

(apercus) {
  # Aperçus de lien (Discord, WhatsApp, Messenger…) : ces robots ne lancent pas
  # l'application ; l'API leur sert le titre, le résumé et l'image de l'article
  # public (compendium.ts, /api/compendium/share). Les visiteurs ne sont pas concernés.
  @apercu {
    path / /compendium /compendium/
    query article=*
    header_regexp User-Agent (?i)(discordbot|whatsapp|facebookexternalhit|facebot|meta-externalagent|twitterbot|slackbot|telegrambot|linkedinbot|skypeuripreview|embedly|pinterest|redditbot|mastodon|bluesky|iframely|signal)
  }
  rewrite @apercu /api/compendium/share?{query}
}

terra-umbra.fr {
  import apercus
  header >Alt-Svc "clear"
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=86400"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
  # Directus (contenu, en fond), avec sa propre connexion.
  redir /cms /cms/ 308
  handle_path /cms/* {
    reverse_proxy directus:8055
  }
  handle /api/* {
    reverse_proxy api:3000
  }
  handle {
    reverse_proxy web:80
  }
}

www.terra-umbra.fr {
  header >Alt-Svc "clear"
  redir https://terra-umbra.fr{uri} 308
}

# Site d'essai (infrastructure/recette), réservé à l'auteur.
# Mot de passe : /opt/terra-umbra/secrets/recette-acces.txt sur le VPS.
dev.terra-umbra.fr {
  import apercus
  header >Alt-Svc "clear"
  encode zstd gzip
  header X-Robots-Tag "noindex, nofollow"
  # Directus (/cms) a sa propre connexion : ses requêtes portent leur propre
  # en-tête d'autorisation, que le mot de passe du site d'essai bloquerait.
  @protege not path /cms /cms/*
  basic_auth @protege {
    recette $2a$14$UpvYBDwL7utoH2XYoRzPoO7kPRoAatWHUYJIH6eihMhu8JKhHeflS
  }
  redir /cms /cms/ 308
  handle_path /cms/* {
    reverse_proxy recette-directus:8055
  }
  handle /api/* {
    reverse_proxy recette-api:3000
  }
  handle {
    reverse_proxy recette-web:80
  }
}
