{
  "name": "@tuc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "check:truth-v7": "npm run build && node scripts/check-truth-v7-readability.mjs && node scripts/check-truth-v7-pass-b.mjs && node scripts/check-truth-v7-lore-integrity.mjs",
    "start": "node dist/server.js",
    "verify:mail": "node dist/verify-mail.js",
    "check:truth-v7-pass-b": "npm run build && node scripts/check-truth-v7-pass-b.mjs",
    "check:truth-v7-lore": "npm run build && node scripts/check-truth-v7-lore-integrity.mjs",
    "check:truth-species": "npm run build && node scripts/check-truth-species-integration.mjs",
    "check:truth-fantastiques": "npm run build && node scripts/check-truth-fantastiques-integration.mjs",
    "check:truth-extraterrestrials": "npm run build && node scripts/check-truth-extraterrestrials-integration.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "fastify": "5.6.1",
    "pg": "8.16.3",
    "nodemailer": "7.0.6"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "@types/nodemailer": "7.0.1"
  }
}
