{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helclaeynn.github.io/Terra-Umbra-Builder/compendium/editor/manual-overrides.schema.json",
  "title": "TUC Compendium manual overrides",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": {"const": 1},
    "updated": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["articleId", "baseHash", "updatedAt", "operations"],
        "properties": {
          "articleId": {"type": "string", "minLength": 1},
          "baseHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "updatedAt": {"type": "string", "format": "date-time"},
          "note": {"type": "string"},
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["op", "path"],
              "properties": {
                "op": {"enum": ["add", "replace", "remove"]},
                "path": {"type": "string", "pattern": "^/"},
                "value": {}
              },
              "allOf": [
                {
                  "if": {"properties": {"op": {"const": "remove"}}},
                  "then": {"not": {"required": ["value"]}},
                  "else": {"required": ["value"]}
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
