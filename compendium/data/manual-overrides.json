    {
      "articleId": "equipement-014-tala-th-029-tomahawk",
      "baseHash": "a8152a40dacf92f161cbbe6467d1ef4d5b05100dff1c56ba49e9c9925b950970",
      "updatedAt": "2026-09-18T11:06:57.707Z",
